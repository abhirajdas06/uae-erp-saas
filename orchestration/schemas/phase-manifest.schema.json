{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uae-erp-saas.invalid/schemas/phase-manifest.schema.json",
  "title": "UAE ERP SaaS phase manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "phases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["id", "title", "status", "specification", "owner_roles", "dependencies", "entry_criteria", "exit_criteria", "required_decisions", "required_adrs", "tasks", "evidence", "approvals", "implementation_authorized", "authorization_reference", "exceptions", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^P(0[0-9]|1[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["PLANNED", "SPECIFICATION_IN_PROGRESS", "AWAITING_APPROVAL", "READY", "IN_PROGRESS", "BLOCKED", "IN_REVIEW", "REJECTED", "AWAITING_HUMAN_APPROVAL", "APPROVED", "DEFERRED", "CANCELLED"]},
        "specification": {"type": "string", "minLength": 1},
        "implementation_authorized": {"type": "boolean"},
        "authorization_reference": {"type": ["string", "null"]}
      }
    }
  }
}

