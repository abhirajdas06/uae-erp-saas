{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uae-erp-saas.invalid/schemas/task-manifest.schema.json",
  "title": "UAE ERP SaaS task manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "phase_id", "title", "objective", "status", "scope", "owner_role", "reviewer_roles", "dependencies", "requirements", "adrs", "risks", "decisions", "acceptance_criteria", "commands", "permissions", "evidence_requirements", "rollback_or_recovery", "implementation_authorized", "authorization_reference", "exceptions", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^P(0[0-9]|1[0-2])-T-[0-9]{3}$"},
        "phase_id": {"type": "string", "pattern": "^P(0[0-9]|1[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["TODO", "READY", "IN_PROGRESS", "BLOCKED", "IN_REVIEW", "FAILED", "DONE", "CANCELLED"]},
        "implementation_authorized": {"type": "boolean"},
        "authorization_reference": {"type": ["string", "null"]}
      }
    }
  }
}
